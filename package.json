{
  "name": "@red-cup-engineering/witness-markdown-write-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Writes one Markdown carrier through write-markdown-file-service and witnesses that write as one witness-journal entry under the same root, so the write and its evidence settle as one apex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/markdown-engineering-services-section.git",
    "directory": "services/markdown-file-services-section/services/witness-markdown-write-service"
  },
  "exports": "./src/index.mjs",
  "bin": {
    "witness-markdown-write": "scripts/witness-markdown-write.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check src/index.mjs && node --check scripts/witness-markdown-write.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/eavt-services-section": "workspace:*",
    "@red-cup-engineering/markdown-engineering-services-section": "workspace:*"
  }
}
